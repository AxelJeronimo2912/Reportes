{
  "expo": {
    "name": "Reportes de mantenimiento",
    "slug": "reportes",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "mx.edu.universidad.reportes",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "mx.edu.universidad.reportes",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "La app usa la cámara para fotografiar el problema de mantenimiento que vas a reportar.",
          "photosPermission": "La app te permite elegir una fotografía existente como evidencia del reporte.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para registrar dónde se encuentra el problema reportado.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store"
    ]
  }
}