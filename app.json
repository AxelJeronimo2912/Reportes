{
  "expo": {
    "name": "reportes",
    "slug": "reportes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Se usa para fotografiar el problema",
          "photosPermission": "Se usa para adjuntar una foto"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se usa para registrar la ubicación del reporte"
        }
      ],
      "expo-secure-store"
    ]
  }
}